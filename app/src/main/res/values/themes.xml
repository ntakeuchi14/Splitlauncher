<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SplitLauncher" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">#3D5AFE</item>
    </style>

    <!-- 中継Activity用: 画面に何も表示しない -->
    <style name="Theme.SplitLauncher.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
