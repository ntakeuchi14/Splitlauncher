<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 任意: adb で許可するとユーザー補助を自動で ON に戻せる（A11yEnabler 参照） -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ のパッケージ可視性: ランチャーに表示されるアプリを列挙するため -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 別APKの「分割1〜5」アプリがインストールされているかの確認用 -->
        <package android:name="com.example.splitlauncher.slot1" />
        <package android:name="com.example.splitlauncher.slot2" />
        <package android:name="com.example.splitlauncher.slot3" />
        <package android:name="com.example.splitlauncher.slot4" />
        <package android:name="com.example.splitlauncher.slot5" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SplitLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2つのアプリを順に起動するだけの透明な中継Activity -->
        <activity
            android:name=".LaunchPairActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SplitLauncher.Transparent" />

        <!-- 別APKの「分割1〜5」アプリからの呼び出し口（スロット番号だけを受け付ける） -->
        <activity-alias
            android:name=".SlotEntry"
            android:exported="true"
            android:targetActivity=".LaunchPairActivity" />

        <!-- アプリ一覧に出す「分割1〜5」。保存されたスロットだけ有効化する -->
        <activity-alias
            android:name=".Slot1"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_slot1"
            android:label="@string/slot1_label"
            android:roundIcon="@mipmap/ic_slot1"
            android:targetActivity=".LaunchPairActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Slot2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_slot2"
            android:label="@string/slot2_label"
            android:roundIcon="@mipmap/ic_slot2"
            android:targetActivity=".LaunchPairActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Slot3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_slot3"
            android:label="@string/slot3_label"
            android:roundIcon="@mipmap/ic_slot3"
            android:targetActivity=".LaunchPairActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Slot4"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_slot4"
            android:label="@string/slot4_label"
            android:roundIcon="@mipmap/ic_slot4"
            android:targetActivity=".LaunchPairActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Slot5"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_slot5"
            android:label="@string/slot5_label"
            android:roundIcon="@mipmap/ic_slot5"
            android:targetActivity=".LaunchPairActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 分割比率をディバイダーのドラッグで調整するためのユーザー補助サービス（任意） -->
        <service
            android:name=".DividerAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
